<mxfile>
  <diagram name="Architecture">
    <mxGraphModel>
      <root>
        <!-- User -->
        <mxCell id="user" value="🌐 USER&#xa;(Browser/curl)" style="rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <!-- FastAPI -->
        <mxCell id="fastapi" value="🚀 FASTAPI&#xa;(Port 8000)" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="160" height="60" as="geometry"/>
        </mxCell>
        
        <!-- PostgreSQL -->
        <mxCell id="postgres" value="🐘 PostgreSQL&#xa;(Port 5432)" style="shape=cylinder3;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="120" height="70" as="geometry"/>
        </mxCell>
        
        <!-- Redis -->
        <mxCell id="redis" value="📦 Redis&#xa;(Port 6379)" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="280" y="280" width="120" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Celery Worker -->
        <mxCell id="worker" value="⚙️ Celery Worker&#xa;(Async Tasks)" style="rounded=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="140" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Ollama -->
        <mxCell id="ollama" value="🤖 Ollama&#xa;(TinyLlama, Port 11434)" style="rounded=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="500" y="400" width="140" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Docker Box -->
        <mxCell id="docker" value="DOCKER COMPOSE NETWORK" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#666666;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="620" height="260" as="geometry"/>
        </mxCell>
        
        <!-- Arrow 1: User to FastAPI -->
        <mxCell id="arrow1" value="1. Upload CSV" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;" edge="1" parent="1" source="user" target="fastapi">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Arrow 2: FastAPI to PostgreSQL -->
        <mxCell id="arrow2" value="2. Create Job" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" parent="1" source="fastapi" target="postgres">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Arrow 3: FastAPI to Redis -->
        <mxCell id="arrow3" value="3. Queue Task" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" parent="1" source="fastapi" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Arrow 4: Redis to Worker -->
        <mxCell id="arrow4" value="4. Dequeue" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" parent="1" source="redis" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Arrow 5: Worker to Ollama -->
        <mxCell id="arrow5" value="5. LLM Call" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" parent="1" source="worker" target="ollama">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Arrow 6: Ollama to Worker (return) -->
        <mxCell id="arrow6" value="6. Categories" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" parent="1" source="ollama" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Arrow 7: Worker to PostgreSQL (save) -->
        <mxCell id="arrow7" value="7. Save Results" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" parent="1" source="worker" target="postgres">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="570" y="370"/>
              <mxPoint x="120" y="370"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- Arrow 8: FastAPI to User (return) -->
        <mxCell id="arrow8" value="8. Return job_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#006600;" edge="1" parent="1" source="fastapi" target="user">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Note boxes - REPOSITIONED -->
        <mxCell id="note1" value="⚡ Async: User gets immediate response" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="200" height="35" as="geometry"/>
        </mxCell>
        
        <mxCell id="note2" value="✅ ACID compliance for financial data" style="rounded=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="220" height="35" as="geometry"/>
        </mxCell>
        
        <mxCell id="note3" value="✅ Free, local LLM&#xa;✅ No API key required" style="rounded=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;" vertex="1" parent="1">
          <mxGeometry x="660" y="400" width="160" height="45" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>